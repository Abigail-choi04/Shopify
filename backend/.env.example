# Copy this file to ".env" in the same folder and fill in real values.
# ".env" itself is git-ignored so your keys never get committed.

# --- Database (Supabase) ---
# Get this from: Supabase dashboard -> Connect button (top right)
# -> URI tab. Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- LLM Provider (Phase 2/3) ---

GROQ_API_KEY=
# Optional — defaults to openai/gpt-oss-120b if left unset
GROQ_MODEL=openai/gpt-oss-120b

# --- Product Search APIs (Phase 4 — flag-gated, not used yet) ---
RAPIDAPI_KEY=
SERPAPI_KEY=